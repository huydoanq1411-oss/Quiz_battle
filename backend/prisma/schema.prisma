generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Lang {
  EN
  JA
}

model User {
  id        Int           @id @default(autoincrement())
  email     String        @unique
  name      String
  password  String
  createdAt DateTime      @default(now())
  matches   MatchPlayer[]
}

model Match {
  id             Int           @id @default(autoincrement())
  code           String
  language       Lang
  totalQuestions Int
  createdAt      DateTime      @default(now())
  players        MatchPlayer[]
}

model MatchPlayer {
  id      Int   @id @default(autoincrement())
  score   Int
  rank    Int
  matchId Int
  userId  Int
  match   Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@index([userId])
}

model KanjiCard {
  id          Int    @id @default(autoincrement())
  kanji       String @unique
  meanings    Json
  kunReadings Json
  onReadings  Json
  jlpt        Int?
  grade       Int?
}
